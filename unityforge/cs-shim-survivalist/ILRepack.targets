<?xml version="1.0" encoding="utf-8"?>
<!-- ILRepack.Lib.MSBuild.Task override: merge 0Harmony (Lib.Harmony
     2.4.2) into the shim, internalized, under our own assembly
     identity. The game's Workshop Harmony 2.0.4 (2021) cannot
     rebuild method bodies containing generic calls on the game's
     Unity 6 Mono; embedding a modern Harmony under our identity
     avoids the first-loaded-wins name fight with other mods'
     0Harmony 2.0.4. Newtonsoft + Unity refs stay external (the
     game provides them).

     Output goes to merged/ (NOT in place): merging over
     $(TargetPath) makes the next incremental build merge Harmony
     into an already-merged dll and die on duplicate types. The
     deploy script ships merged/. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="ILRepacker" AfterTargets="Build">
    <MakeDir Directories="$(TargetDir)merged" />
    <ItemGroup>
      <InputAssemblies Include="$(TargetPath)" />
      <InputAssemblies Include="$(TargetDir)0Harmony.dll" />
      <LibraryPath Include="$(TargetDir)" />
      <LibraryPath Include="$(UnityDir)" Condition="'$(UnityDir)' != ''" />
    </ItemGroup>
    <ILRepack
      Parallel="true"
      Internalize="true"
      InputAssemblies="@(InputAssemblies)"
      LibraryPath="@(LibraryPath)"
      TargetKind="Dll"
      OutputFile="$(TargetDir)merged\$(TargetFileName)" />
  </Target>
</Project>

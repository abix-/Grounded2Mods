<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net472, matching the game's own modding guide (.NET
         Framework class libraries; DisableHUD ships net40).
         Unity's Mono loads net4x assemblies natively. -->
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Unityforge.Shim.Survivalist</AssemblyName>
    <Version>0.1.0</Version>
    <LangVersion>9.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- true so 0Harmony.dll lands in the output dir for the
         ILRepack merge below. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- No RootNamespace: the game's loader looks up the type
         "Main" in the GLOBAL namespace (Story.LoadDLLs does
         assembly.GetType("Main")). -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Common sources linked from cs-shim-common (shared with the
         BepInEx shims). -->
    <Compile Include="..\cs-shim-common\Bridge.cs">
      <Link>Common\Bridge.cs</Link>
    </Compile>
    <Compile Include="..\cs-shim-common\GenerationLoader.cs">
      <Link>Common\GenerationLoader.cs</Link>
    </Compile>
    <Compile Include="..\cs-shim-common\HarmonyBridge.cs">
      <Link>Common\HarmonyBridge.cs</Link>
    </Compile>
    <Compile Include="..\cs-shim-common\Logger.cs">
      <Link>Common\Logger.cs</Link>
    </Compile>
    <Compile Include="..\cs-shim-common\InputBridge.cs">
      <Link>Common\InputBridge.cs</Link>
    </Compile>
    <Compile Include="..\cs-shim-common\TypeCache.cs">
      <Link>Common\TypeCache.cs</Link>
    </Compile>
    <!-- The Mono backend is host-agnostic (pure System.Reflection +
         Newtonsoft.Json); link it from the BepInEx Mono shim. -->
    <Compile Include="..\cs-shim-mono\MonoBridge.cs">
      <Link>Common\MonoBridge.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!--
      Modern pardeike Harmony, MERGED into this shim under our own
      assembly identity (ILRepack target below, internalized). The
      game's Workshop "Harmony 2.0.4" (a 2021 community upload)
      predates the game's Unity 6 engine and cannot rebuild method
      bodies containing generic calls (live-verified 2026-07-04:
      Character.AddInjury's List<Injury>.Add). Merging under our
      identity means no name fight with other mods' 0Harmony 2.0.4
      (first-loaded wins for the plain "0Harmony" name) and no
      workshop dependency needed.

      Unity references come from the game's Managed dir via
      -p:UnityDir like the other shims.
    -->
    <PackageReference Include="Lib.Harmony" Version="2.4.2" PrivateAssets="all" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.43" PrivateAssets="all" />
    <!-- The game assembly itself: the settlement-upgrades patches
         (Upgrades.cs) are written against the real game types,
         the same model as the game's own example mods. -->
    <Reference Include="Assembly-CSharp" Condition="'$(UnityDir)' != ''">
      <Private>false</Private>
      <HintPath>$(UnityDir)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine" Condition="'$(UnityDir)' != ''">
      <Private>false</Private>
      <HintPath>$(UnityDir)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Condition="'$(UnityDir)' != ''">
      <Private>false</Private>
      <HintPath>$(UnityDir)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule" Condition="'$(UnityDir)' != ''">
      <Private>false</Private>
      <HintPath>$(UnityDir)\UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- The 0Harmony merge lives in ILRepack.targets next to this
       csproj (the ILRepack.Lib.MSBuild.Task override point; a
       Target here in the csproj collides with the package's own
       merge target and feeds the shim in twice). -->

</Project>
